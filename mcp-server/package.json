{
  "name": "nativecode-audit-mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol server that exposes NativeCode Audit AI-visibility data (citation frequency, share of voice, sentiment, Share of Model Voice) to LLMs and agents.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nativecode-audit-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
